  "query": "\n        SELECT o.id, o.status, t.table_number, t.name as table_name\n        FROM orders o\n        JOIN tables t ON t.id = o.table_id\n        WHERE o.session_token = $1 AND o.status IN ('open', 'checkout_pending')\n        ",

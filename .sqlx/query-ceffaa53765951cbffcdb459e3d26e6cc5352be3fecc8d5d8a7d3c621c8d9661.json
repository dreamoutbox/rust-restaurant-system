{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            oi.id,\n            oi.order_id,\n            oi.status as current_status,\n            m.name as item_name,\n            t.table_number\n        FROM order_items oi\n        JOIN orders o ON o.id = oi.order_id\n        JOIN tables t ON t.id = o.table_id\n        JOIN menu_items m ON m.id = oi.menu_item_id\n        WHERE oi.id = $1\n        ",

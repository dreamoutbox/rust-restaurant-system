{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            t.id,\n            t.table_number,\n            t.name,\n            t.capacity,\n            t.is_active,\n            o.id as \"active_order_id?\",\n            o.session_token as \"active_session_token?\",\n            o.status as \"order_status?\"\n        FROM tables t\n        LEFT JOIN orders o ON o.table_id = t.id AND o.status IN ('open', 'checkout_pending')\n        ORDER BY t.table_number ASC\n        ",

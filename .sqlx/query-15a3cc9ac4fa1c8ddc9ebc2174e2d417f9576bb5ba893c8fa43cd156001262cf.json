{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                oi.id,\n                oi.order_id,\n                t.table_number,\n                oi.menu_item_id,\n                m.name as menu_item_name,\n                oi.quantity,\n                oi.unit_price as \"unit_price!: i64\",\n                oi.note,\n                oi.status,\n                oi.created_at\n            FROM order_items oi\n            JOIN orders o ON o.id = oi.order_id\n            JOIN tables t ON t.id = o.table_id\n            JOIN menu_items m ON m.id = oi.menu_item_id\n            WHERE oi.order_id = $1\n            ORDER BY oi.created_at ASC\n            ",

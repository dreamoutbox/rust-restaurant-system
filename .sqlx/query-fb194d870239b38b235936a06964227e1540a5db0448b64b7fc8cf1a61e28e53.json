{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            m.id,\n            m.category_id,\n            c.name as category_name,\n            m.name,\n            m.description,\n            m.price as \"price!: i64\",\n            m.image_path,\n            m.is_available,\n            m.sort_order\n        FROM menu_items m\n        JOIN categories c ON c.id = m.category_id\n        WHERE m.deleted_at IS NULL\n        ORDER BY c.sort_order ASC, m.sort_order ASC, m.name ASC\n        ",

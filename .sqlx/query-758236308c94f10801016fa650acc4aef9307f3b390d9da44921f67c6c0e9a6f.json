{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            o.id,\n            o.table_id,\n            t.table_number,\n            t.name as table_name,\n            o.session_token,\n            o.status,\n            o.total_amount as \"total_amount!: i64\",\n            o.payment_method,\n            o.stripe_session_id,\n            o.opened_at,\n            o.closed_at\n        FROM orders o\n        JOIN tables t ON t.id = o.table_id\n        WHERE o.id = $1\n        ",
